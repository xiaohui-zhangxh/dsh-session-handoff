{
  "name": "@local/dsh-session-handoff",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: shows the live conversation turn count and hands the task to a fresh session when a configurable turn limit is reached",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "handoff",
    "turns"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohui-zhangxh/dsh-session-handoff.git"
  }
}
